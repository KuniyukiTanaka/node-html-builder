{
  "name": "node-html-builder",
  "decription": "node-html-builders",
  "version": "1.0.0",
  "license": "MIT",
  "author": "Kuniyuki Tanaka",
  "type": "module",
  "private": true,
  "volta": {
    "node": "24.11.1"
  },
  "engines": {
    "node": ">=24"
  },
  "bin": {
    "build-tmpl": "./run/build-tmpl.js"
  },
  "scripts": {
    "build-tmpl": "run-p build onchange",
    "build": "build-tmpl",
    "onchange": "onchange \"assets/templates/**/*\" -e \"**/_**/**\" -- build-tmpl -f {{file}}",
    "build-demo": "run-p demo:b demo:l",
    "demo:b": "node run/build-tmpl -z",
    "demo:l": "onchange \"assets@demo/templates/**/*\" -e \"**/_**/**\" -- node run/build-tmpl -z -f {{file}}",
    "media-comp": "node run/mediacomp",
    


    "test:asset": "node --test test/Asset.test.mjs"
  },
  "dependencies": {
    "autoprefixer": "^10.4.22",
    "browser-sync": "^3.0.4",
    "csv-parse": "^6.1.0",
    "ejs": "^3.1.10",
    "onchange": "^7.1.0",
    "npm-run-all": "^4.1.5",
    "postcss": "^8.5.6",
    "postcss-gap-properties": "^6.0.0",
    "postcss-minify": "^1.2.0",
    "sass": "^1.94.2",
    "sharp": "^0.34.5",
    "uglify-js": "^3.19.3"
  },
  "devDependencies": {
    "baseline-browser-mapping": "^2.9.18"
  }
}
